# Required because expo-router's optional web UI tooling (@radix-ui/*, vaul)
# needs react-dom@19.2.8, whose peer range conflicts with the react@19.2.3
# pin create-expo-app selected for this SDK 57 project (confirmed correct by
# `expo-doctor`, 20/20 checks). See commit 03713b9 for the full investigation
# and verification (real install + tsc + expo export, not just a dry run).
# Safe to remove once expo-router's web dependency tree stops requiring a
# newer react-dom than the RN-pinned react version — recheck on SDK upgrades,
# since legacy-peer-deps also hides genuinely new peer conflicts.
legacy-peer-deps=true
